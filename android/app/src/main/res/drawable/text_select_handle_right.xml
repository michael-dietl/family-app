<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="12dp" android:height="24dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <size android:width="10dp" android:height="10dp" />
            <solid android:color="#ff7a18" />
        </shape>
    </item>
    <item android:gravity="bottom|center_horizontal" android:bottom="8dp">
        <shape android:shape="rectangle">
            <size android:width="3dp" android:height="12dp" />
            <solid android:color="#ff7a18" />
            <corners android:radius="1.5dp" />
        </shape>
    </item>
</layer-list>
